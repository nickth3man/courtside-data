.idea/
*.pyc
.pypirc
build/
dist/
*egg-info/
bin/
lib/

# Environment variables (non-sensitive defaults documented in .env.example)
.env
# Share the project's VS Code config, but keep personal/local bits out
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# Don't commit generated test outputs (real path: tests/integration/client/output/)
tests/integration/client/output/generated/*.csv
tests/integration/client/output/generated/*/*.csv
tests/integration/client/output/generated/*/*/*.csv
tests/integration/client/output/generated/*.json
tests/integration/client/output/generated/*/*.json
tests/integration/client/output/generated/*/*/*.json

# Don't commit files from end to end test output
tests/end to end/output/generated/**.json
tests/end to end/output/generated/**.csv
!tests/end to end/output/.gitkeep

# Staged fixtures are local-only (HTML is large and replaceable from BR).
# The .meta.json sidecars are kept so the pre-commit drift hook can compare
# downloaded_at to expected file mtime (see scripts/check_fixture_sync.py).
staged_fixtures/**/*.html
!staged_fixtures/**/.gitkeep

# Stray local artifacts (Windows `nul` device redirect, leftover staging dirs)
nul
staged_fixtures_test/

# Ignore generated code coverage files
.coverage
coverage.xml

# Ignore generated endpoint test artifacts
scripts/test_endpoints/*.json
scripts/test_endpoints/*.log

dependencies/*

# virtualenv's
venv/
.venv/
pyvenv.cfg

# caches
.pytest_cache/
**/*/__pycache__/

# Local opencode/slim state
.slim/

# Local AI tooling artifacts
.ignore
AGENTS.md

# Generated codemaps
codemap.md
courtside_data/codemap.md
courtside_data/output/codemap.md

# Local analysis / sample data
endpoint_samples.csv
missing_datapoints.md
.plans/
