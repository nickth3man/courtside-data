# Ensure all text files are checked out with LF line endings on all platforms.
# This is the GitHub-recommended cross-platform approach.
# Reference: https://docs.github.com/en/get-started/getting-started-with-git/configuring-git-to-handle-line-endings

# Default for all text files
* text=auto eol=lf

# Explicit LF for common text types (overrides git's auto-detection)
*.py text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.txt text eol=lf

# Binary files (no line-ending translation)
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
