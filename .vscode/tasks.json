{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "test",
      "detail": "Full offline suite (parallel, preferred)",
      "type": "shell",
      "command": "uv run pytest tests -n auto -q",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "test: serial",
      "detail": "Full offline suite without xdist workers",
      "type": "shell",
      "command": "uv run pytest tests -q",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "lint",
      "detail": "Ruff lint check",
      "type": "shell",
      "command": "uv run ruff check .",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "format",
      "detail": "Ruff format the repo",
      "type": "shell",
      "command": "uv run ruff format .",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "typecheck",
      "detail": "ty type check the package",
      "type": "shell",
      "command": "uv run ty check courtside_data",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "check: all",
      "detail": "Lint + typecheck + tests (same gauntlet as CI)",
      "dependsOrder": "sequence",
      "dependsOn": ["lint", "typecheck", "test"],
      "problemMatcher": []
    }
  ]
}
